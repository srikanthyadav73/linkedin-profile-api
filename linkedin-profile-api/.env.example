# Copy this file to .env and fill in real values. .env is git-ignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Captapi API key — fallback or primary LinkedIn data provider.
# Get a free key (258 credits, no credit card) at: https://captapi.com/dashboard
CAPTAPI_API_KEY=your_captapi_key_here

# (Optional) LinkedIn Session Cookie (li_at) for reverse-engineered Voyager API access.
# Provides 100% complete authenticated data including hidden education and skills.
# Find it in your browser: DevTools -> Application -> Cookies -> linkedin.com -> 'li_at'
LINKEDIN_LI_AT_COOKIE=

